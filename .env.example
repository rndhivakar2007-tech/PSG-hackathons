# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_PASSCODE: Optional server-side passcode to unlock initial Super Admin provisioning.
ADMIN_BOOTSTRAP_PASSCODE=

# Optional Supabase configuration for hosted PostgreSQL + Supabase Auth deployment
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Routing & Notification Provider overrides (defaults to public OSRM & local in-app dispatch)
OSRM_BASE_URL=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
